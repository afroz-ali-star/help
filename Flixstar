                            date: "2023-04-10T18:45:00Z"
                        }
                    ]
                };
                saveComments();
            }
        }

        function saveComments() {
            localStorage.setItem('movieComments', JSON.stringify(comments));
        }

        function getMovieRanking(movieId) {
            const sortedMovies = [...movies].sort((a, b) => b.views - a.views);
            const index = sortedMovies.findIndex(movie => movie.id === movieId);
            return index < 3 ? index + 1 : null;
        }

        function showNotification(message, isSuccess = true) {
            const notification = document.getElementById('notification');
            const notificationMessage = document.getElementById('notification-message');
            const icon = notification.querySelector('i');
            
            notificationMessage.textContent = message;
            notification.className = isSuccess ? 'notification active' : 'notification error active';
            icon.className = isSuccess ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
            
            setTimeout(() => {
                notification.classList.remove('active');
            }, 3000);
        }

        function showLoading(show) {
            const spinner = document.getElementById('loading-spinner');
            if (show) {
                spinner.classList.add('active');
            } else {
                spinner.classList.remove('active');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadViewCounts();
            loadComments();
            loadMovies();
            setupHeaderScroll();
            setupSearch();
            checkAuthState();
            setupCommentForm();
            
            // Simulate loading
            showLoading(true);
            setTimeout(() => {
                showLoading(false);
            }, 1500);
        });

        function setupHeaderScroll() {
            const header = document.getElementById('header');
            window.addEventListener('scroll', function() {
                if (window.scrollY > 10) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            });
        }

        function setupSearch() {
            const searchInput = document.getElementById('search-input');
            const searchResults = document.getElementById('search-results');
            const mobileSearchInput = document.getElementById('mobile-search-input');
            const mobileSearchResults = document.getElementById('mobile-search-results');

            const handleSearch = (inputElement, resultsContainer) => {
                const query = inputElement.value.toLowerCase().trim();
                resultsContainer.innerHTML = '';

                if (query.length === 0) {
                    resultsContainer.classList.remove('active');
                    return;
                }

                const filteredMovies = movies.filter(movie => 
                    movie.title.toLowerCase().includes(query) ||
                    movie.category.toLowerCase().includes(query) ||
                    movie.year.toString().includes(query)
                );

                if (filteredMovies.length > 0) {
                    filteredMovies.forEach(movie => {
                        const resultItem = document.createElement('div');
                        resultItem.className = 'search-result-item';
                        resultItem.innerHTML = `
                            <img src="${movie.image}" alt="${movie.title}" onerror="this.src='https://via.placeholder.com/40x60?text=No+Image'">
                            <div class="search-result-info">
                                <div class="search-result-title">${movie.title}</div>
                                <div class="search-result-meta">
                                    <span><i class="fas fa-calendar-alt"></i> ${movie.year}</span>
                                    <span><i class="fas fa-tag"></i> ${movie.category}</span>
                                    <span class="movie-views"><i class="fas fa-eye"></i> ${movie.views}</span>
                                </div>
                            </div>
                        `;
                        resultItem.addEventListener('click', () => {
                            showMovieModal(movie.id);
                            resultsContainer.classList.remove('active');
                            inputElement.value = '';
                        });
                        resultsContainer.appendChild(resultItem);
                    });
                    resultsContainer.classList.add('active');
                } else {
                    const noResults = document.createElement('div');
                    noResults.className = 'search-result-item';
                    noResults.innerHTML = '<i class="fas fa-search"></i> No results found';
                    resultsContainer.appendChild(noResults);
                    resultsContainer.classList.add('active');
                }
            };

            searchInput.addEventListener('input', () => handleSearch(searchInput, searchResults));
            searchInput.addEventListener('focus', () => {
                if (searchInput.value.trim().length > 0) {
                    searchResults.classList.add('active');
                }
            });
            document.addEventListener('click', (e) => {
                if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
                    searchResults.classList.remove('active');
                }
            });

            mobileSearchInput.addEventListener('input', () => handleSearch(mobileSearchInput, mobileSearchResults));
            mobileSearchInput.addEventListener('focus', () => {
                if (mobileSearchInput.value.trim().length > 0) {
                    mobileSearchResults.classList.add('active');
                }
            });
            document.addEventListener('click', (e) => {
                if (!mobileSearchInput.contains(e.target) && !mobileSearchResults.contains(e.target)) {
                    mobileSearchResults.classList.remove('active');
                }
            });
        }

        function setupCommentForm() {
            const commentForm = document.getElementById('comment-form');
            const commentText = document.getElementById('comment-text');
            const commentSubmitBtn = document.getElementById('comment-submit-btn');

            commentForm.addEventListener('submit', function(e) {
                e.preventDefault();
                postComment();
            });

            commentText.addEventListener('input', function() {
                commentSubmitBtn.disabled = commentText.value.trim() === '';
            });
        }

        function toggleMobileSearch() {
            const mobileSearchContainer = document.getElementById('mobile-search-container');
            mobileSearchContainer.classList.toggle('active');
            if (mobileSearchContainer.classList.contains('active')) {
                document.getElementById('mobile-search-input').focus();
            }
        }

        function loadMovies() {
            if (currentView === "all-movies") return;
            
            const trendingSlider = document.getElementById('trending-slider');
            const popularMovies = [...movies].sort((a, b) => b.views - a.views);
            // Show all trending movies (no "See All" button)
            loadSlider(trendingSlider, popularMovies);

            const actionSlider = document.getElementById('action-slider');
            const actionMovies = movies.filter(movie => movie.category === 'Action');
            // Show only 10 action movies initially
            loadSlider(actionSlider, actionMovies.slice(0, 10));

            const dramaSlider = document.getElementById('drama-slider');
            const dramaMovies = movies.filter(movie => movie.category === 'Drama');
            // Show only 10 drama movies initially
            loadSlider(dramaSlider, dramaMovies.slice(0, 10));
        }

        function loadSlider(slider, moviesToLoad) {
            slider.innerHTML = '';
            
            moviesToLoad.forEach((movie, index) => {
                const card = document.createElement('div');
                card.className = 'movie-card';
                card.setAttribute('data-id', movie.id);
                card.style.animationDelay = `${index * 0.05}s`;
                
                const ranking = getMovieRanking(movie.id);
                const rankingBadge = ranking ? 
                    `<div class="ranking-badge rank-${ranking}">${ranking}</div>` : '';
                
                card.innerHTML = `
                    ${rankingBadge}
                    <img src="${movie.image}" alt="${movie.title}" class="movie-poster" onerror="this.src='https://via.placeholder.com/300x450?text=Poster+Not+Available'">
                    <div class="movie-info">
                        <h3 class="movie-title">${movie.title}</h3>
                        <div class="movie-meta">
                            <span>${movie.year}</span>
                            <span class="movie-views"><i class="fas fa-eye"></i> ${movie.views}</span>
                        </div>
                    </div>
                `;
                
                card.addEventListener('click', () => showMovieModal(movie.id));
                slider.appendChild(card);
            });
        }

        function showAllMovies(category) {
            currentView = "all-movies";
            const rowsContainer = document.getElementById('rows-container');
            let filteredMovies = [];
            let title = '';

            switch(category) {
                case 'action':
                    filteredMovies = movies.filter(movie => movie.category === 'Action');
                    title = 'All Action Movies';
                    break;
                case 'drama':
                    filteredMovies = movies.filter(movie => movie.category === 'Drama');
                    title = 'All Dramas';
                    break;
                default:
                    filteredMovies = movies;
                    title = 'All Movies';
            }

            rowsContainer.innerHTML = `
                <div class="row">
                    <h2 class="row-title">${title}</h2>
                    <div class="slider-container">
                        <div class="slider" id="all-movies-slider"></div>
                    </div>
                </div>
                <button class="back-to-browse" onclick="reloadPage()">
                    <i class="fas fa-arrow-left"></i> Back to Browse
                </button>
            `;

            const allMoviesSlider = document.getElementById('all-movies-slider');
            filteredMovies.forEach((movie, index) => {
                const card = document.createElement('div');
                card.className = 'movie-card';
                card.setAttribute('data-id', movie.id);
                card.style.animationDelay = `${index * 0.03}s`;
                
                const ranking = getMovieRanking(movie.id);
                const rankingBadge = ranking ? 
                    `<div class="ranking-badge rank-${ranking}">${ranking}</div>` : '';
                
                card.innerHTML = `
                    ${rankingBadge}
                    <img src="${movie.image}" alt="${movie.title}" class="movie-poster" onerror="this.src='https://via.placeholder.com/300x450?text=Poster+Not+Available'">
                    <div class="movie-info">
                        <h3 class="movie-title">${movie.title}</h3>
                        <div class="movie-meta">
                            <span>${movie.year}</span>
                            <span class="movie-views"><i class="fas fa-eye"></i> ${movie.views}</span>
                        </div>
                    </div>
                `;
                
                card.addEventListener('click', () => showMovieModal(movie.id));
                allMoviesSlider.appendChild(card);
            });
        }

        function scrollSlider(sliderId, amount) {
            const slider = document.getElementById(sliderId);
            slider.scrollBy({
                left: amount,
                behavior: 'smooth'
            });
        }

        function reloadPage() {
            currentView = "default";
            window.location.reload();
        }

        function showAboutUs() {
            document.querySelector('.rows-container').innerHTML = `
                <div class="about-us" style="padding: 2rem; background-color: rgba(0,0,0,0.7); border-radius: 8px; animation: fadeInUp 0.5s ease forwards;">
                    <h2 style="font-size: 2rem; margin-bottom: 1rem; color: var(--primary-red);">About Flixstar</h2>
                    <p style="margin-bottom: 1rem; line-height: 1.6;">Welcome to Flixstar, your premium streaming service for all your favorite movies and TV shows. Enjoy a Netflix-style browsing experience with smooth animations and intuitive navigation.</p>
                    <p style="margin-bottom: 1rem; line-height: 1.6;">Our platform features:</p>
                    <ul style="margin-bottom: 1.5rem; padding-left: 1.5rem; line-height: 1.6;">
                        <li>Trending and popular content</li>
                        <li>Personalized recommendations</li>
                        <li>Smooth animated transitions</li>
                        <li>Responsive design for all devices</li>
                    </ul>
                    <button class="back-to-browse" onclick="reloadPage()">
                        <i class="fas fa-arrow-left"></i> Back to Browse
                    </button>
                </div>
            `;
        }

        function watchMovie(movieId, url) {
            const movie = movies.find(m => m.id === movieId);
            if (movie) {
                movie.views++;
                saveViewCounts();
                
                document.querySelectorAll(`.movie-card[data-id="${movieId}"] .movie-views`).forEach(el => {
                    el.innerHTML = `<i class="fas fa-eye"></i> ${movie.views}`;
                });
                
                updateRankings();
            }
            
            if (!url) {
                showNotification('Sorry, this movie is not available at the moment.', false);
                return;
            }
            
            // Directly open the URL without confirmation
            window.open(url, '_blank');
        }

        function showMovieModal(movieId) {
            const movie = movies.find(m => m.id === movieId);
            if (!movie) return;

            // Update view count
            movie.views++;
            saveViewCounts();
            updateRankings();

            // Set current movie ID
            currentMovieId = movieId;

            // Update modal content
            document.getElementById('movie-modal-title').textContent = movie.title;
            document.getElementById('movie-modal-year').textContent = movie.year;
            document.getElementById('movie-modal-category').textContent = movie.category;
            document.getElementById('movie-views-count').textContent = movie.views;
            document.getElementById('movie-modal-description').textContent = movie.description;
            document.getElementById('movie-modal-poster').src = movie.image;
            document.getElementById('movie-modal-poster').alt = movie.title;
            document.getElementById('movie-modal-backdrop').src = movie.backdrop || movie.image;
            document.getElementById('movie-modal-backdrop').alt = movie.title + ' backdrop';
            
            // Set play button action
            document.getElementById('movie-modal-play-btn').onclick = function() {
                watchMovie(movie.id, movie.url);
            };

            // Load comments
            loadMovieComments(movieId);

            // Show modal
            document.getElementById('movie-modal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function hideMovieModal() {
            document.getElementById('movie-modal').classList.remove('active');
            document.body.style.overflow = '';
            document.getElementById('comment-text').value = '';
            document.getElementById('comment-submit-btn').disabled = true;
        }

        function loadMovieComments(movieId) {
            const commentsList = document.getElementById('comments-list');
            commentsList.innerHTML = '';

            if (!comments[movieId] || comments[movieId].length === 0) {
                commentsList.innerHTML = '<div class="no-comments">No comments yet. Be the first to share your thoughts!</div>';
                return;
            }

            // Sort comments by date (newest first)
            const sortedComments = [...comments[movieId]].sort((a, b) => new Date(b.date) - new Date(a.date));

            sortedComments.forEach(comment => {
                const commentElement = document.createElement('div');
                commentElement.className = 'comment';
                
                const date = new Date(comment.date);
                const formattedDate = date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                commentElement.innerHTML = `
                    <div class="comment-header">
                        <div class="comment-avatar">${comment.username.charAt(0).toUpperCase()}</div>
                        <div>
                            <div class="comment-user">${comment.username}</div>
                            <div class="comment-date">${formattedDate}</div>
                        </div>
                    </div>
                    <div class="comment-content">${comment.text}</div>
                `;
                
                commentsList.appendChild(commentElement);
            });
        }

        function postComment() {
            if (!currentUser) {
                showNotification('Please sign in to post a comment', false);
                showAuthModal();
                return;
            }

            const commentText = document.getElementById('comment-text').value.trim();
            if (!commentText) return;

            if (!comments[currentMovieId]) {
                comments[currentMovieId] = [];
            }

            const newComment = {
                id: Date.now(),
                userId: currentUser.email === adminAccount.email ? 1 : 2, // Simple user ID assignment
                username: currentUser.name,
                text: commentText,
                date: new Date().toISOString()
            };

            comments[currentMovieId].unshift(newComment);
            saveComments();

            // Reload comments
            loadMovieComments(currentMovieId);

            // Clear textarea
            document.getElementById('comment-text').value = '';
            document.getElementById('comment-submit-btn').disabled = true;

            showNotification('Comment posted successfully!');
        }

        function updateRankings() {
            const cards = document.querySelectorAll('.movie-card');
            
            cards.forEach(card => {
                const movieId = parseInt(card.getAttribute('data-id'));
                const ranking = getMovieRanking(movieId);
                
                const existingBadge = card.querySelector('.ranking-badge');
                if (existingBadge) {
                    existingBadge.remove();
                }
                
                if (ranking) {
                    const badge = document.createElement('div');
                    badge.className = `ranking-badge rank-${ranking}`;
                    badge.textContent = ranking;
                    card.insertBefore(badge, card.firstChild);
                }
            });
        }

        function showAuthModal() {
            const modal = document.getElementById('auth-modal');
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function hideAuthModal() {
            document.getElementById('auth-modal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function signIn() {
            const email = document.getElementById('signin-email').value.trim();
            const password = document.getElementById('signin-password').value.trim();
            
            if (!email || !password) {
                showNotification('Please fill in all fields', false);
                return;
            }
            
            // Show loading spinner
            showLoading(true);
            
            // Simulate API call
            setTimeout(() => {
                // Check against admin account
                if (email === adminAccount.email && password === adminAccount.password) {
                    currentUser = { name: adminAccount.name, email: adminAccount.email };
                    localStorage.setItem('flixstar-current-user', JSON.stringify(currentUser));
                    
                    updateAuthUI();
                    hideAuthModal();
                    showNotification('Welcome back, ' + adminAccount.name + '!');
                } else {
                    showNotification('Invalid email or password', false);
                }
                
                showLoading(false);
            }, 1000);
        }

        function signOut() {
            currentUser = null;
            localStorage.removeItem('flixstar-current-user');
            updateAuthUI();
            showNotification('You have been signed out');
        }

        function checkAuthState() {
            const userData = localStorage.getItem('flixstar-current-user');
            if (userData) {
                currentUser = JSON.parse(userData);
            }
            updateAuthUI();
        }

        function updateAuthUI() {
            const authButtons = document.getElementById('auth-buttons');
            const userProfile = document.getElementById('user-profile');
            const usernameDisplay = document.getElementById('username-display');
            const userAvatar = document.getElementById('user-avatar');
            
            if (currentUser) {
                authButtons.style.display = 'none';
                userProfile.style.display = 'flex';
                usernameDisplay.textContent = currentUser.name;
                userAvatar.textContent = currentUser.name.charAt(0).toUpperCase();
            } else {
                authButtons.style.display = 'flex';
                userProfile.style.display = 'none';
            }
        }

        document.getElementById('user-avatar').addEventListener('click', function(e) {
            e.stopPropagation();
            document.getElementById('user-menu').classList.toggle('active');
        });

        document.addEventListener('click', function() {
            document.getElementById('user-menu').classList.remove('active');
        });

        document.getElementById('user-menu').addEventListener('click', function(e) {
            e.stopPropagation();
        });

        // Close auth modal when clicking outside
        document.getElementById('auth-modal').addEventListener('click', function(e) {
            if (e.target === this) {
                hideAuthModal();
            }
        });

        // Close movie modal when clicking outside
        document.getElementById('movie-modal').addEventListener('click', function(e) {
            if (e.target === this) {
                hideMovieModal();
            }
        });

        // Close mobile search when clicking outside
        document.addEventListener('click', function(e) {
            const mobileSearchContainer = document.getElementById('mobile-search-container');
            const mobileSearchBtn = document.querySelector('.mobile-search-btn');
            
            if (mobileSearchContainer.classList.contains('active') && 
                !mobileSearchContainer.contains(e.target) && 
                !mobileSearchBtn.contains(e.target)) {
                mobileSearchContainer.classList.remove('active');
            }emailjs.send("service_o2ssj8o","template_evuwd57");
            

        });
    </script>
